# Copy to deploy/.env. Never commit the real file.
TRYST_ENV=dev
POSTGRES_PASSWORD=change-me
RP_ID=localhost
RP_ORIGINS=http://localhost:3000
# The web container proxies the API; trust it for X-Forwarded-For (compose network range).
TRUSTED_PROXIES=172.16.0.0/12
# Production secrets (KMS / secret manager in production; hex 32 bytes unless noted):
# DATA_KEK=
# DSR_SIGNING_KEY=
# CONTACT_PEPPER=
# VAPID_PRIVATE_KEY=          (base64url P-256 scalar)
# POSTMARK_SERVER_TOKEN= / TWILIO_ACCOUNT_SID= TWILIO_AUTH_TOKEN= TWILIO_MESSAGING_SERVICE=
# STRIPE_SECRET_KEY= STRIPE_WEBHOOK_SECRET= STRIPE_PRICE_TRYST_PLUS= ...
# LIVENESS_URL= LIVENESS_API_KEY= LIVENESS_SECRET=
# SIGHTENGINE_USER= SIGHTENGINE_SECRET= PHOTODNA_KEY=
# ARC_URL= ARC_API_KEY= ARC_SECRET=
# Internal calls between the API and the safety service (hex, ≥ 32 bytes, one per direction):
# INTERNAL_SECRET_SAFETY=   INTERNAL_SECRET_PLATFORM=
# Staff sign-in for the safety service's console (production): the proxy's signed token
# STAFF_ACCESS_ISSUER=https://<team>.cloudflareaccess.com  STAFF_ACCESS_AUDIENCE=<aud tag>
# STAFF_ACCESS_JWKS_URL=https://<team>.cloudflareaccess.com/cdn-cgi/access/certs
# STAFF_ROSTER=mod@company.example:moderator;lead@company.example:lead,moderator
# Dev only: STAFF_DEV_TOKENS=mod1:moderator:<16+ chars>,lead1:lead:<16+ chars>
