# deploy/gcp/<env>.secrets.env: vendor credentials, read by setup.sh and stored in Secret
# Manager. Never commit this file (it is in .gitignore). Leave out what you don't use yet.
# Lines are KEY=value with no quotes.
SMTP_PASSWORD=
# Identity and age assurance provider
ASSURANCE_URL=
ASSURANCE_PROVIDER=
ASSURANCE_CERTS=
ASSURANCE_SECRET=
ASSURANCE_API_KEY=
ASSURANCE_CALLBACK_SECRET=
LIVENESS_URL=
LIVENESS_SECRET=
LIVENESS_API_KEY=
# Alarm-receiving centre (meet safety line)
ARC_URL=
ARC_SECRET=
ARC_API_KEY=
# Stripe (TRYST+)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_TRYST_PLUS=
STRIPE_PRICE_TRYST_PLUS_ANNUAL=
# Photo safety (optional at launch: without these every photo goes to a moderator)
PHOTODNA_KEY=
SIGHTENGINE_USER=
SIGHTENGINE_SECRET=
# Off-site backup copy on the Hostinger VPS (optional): user@host:/path, and a private key
OFFSITE_TARGET=
OFFSITE_SSH_KEY_FILE=
