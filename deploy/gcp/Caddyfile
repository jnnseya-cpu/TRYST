# Only Cloudflare reaches this VM (the firewall allows 443 from Cloudflare's ranges only).
# Caddy trusts Cloudflare's X-Forwarded-For so the API sees the member's address, not
# Cloudflare's. TLS: a Cloudflare origin certificate ("Full (strict)" mode).
{
	auto_https off
	servers {
		trusted_proxies static 173.245.48.0/20 103.21.244.0/22 103.22.200.0/22 103.31.4.0/22 141.101.64.0/18 108.162.192.0/18 190.93.240.0/20 188.114.96.0/20 197.234.240.0/22 198.41.128.0/17 162.158.0.0/15 104.16.0.0/13 104.24.0.0/14 172.64.0.0/13 131.0.72.0/22 2400:cb00::/32 2606:4700::/32 2803:f800::/32 2405:b500::/32 2405:8100::/32 2a06:98c0::/29 2c0f:f248::/32
		client_ip_headers X-Forwarded-For
	}
}

(common) {
	tls /etc/tryst/origin/cert.pem /etc/tryst/origin/key.pem
	encode zstd gzip
	header -Server
	log {
		output stdout
		format filter {
			wrap json
			fields {
				request>remote_ip delete
				request>client_ip delete
				request>headers delete
				request>uri delete
			}
		}
	}
}

{$SITE_HOST} {
	import common
	reverse_proxy web:3000
}

# Staff console: Cloudflare Access (safety team, hardware keys) sits in front of this host,
# and the safety service verifies Access's signed token itself.
{$CONSOLE_HOST} {
	import common
	reverse_proxy ops:3000
}
