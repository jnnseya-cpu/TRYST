#!/usr/bin/env bash
# Stand-in for the AWS CLI (Secrets Manager only), storing values under $FAKE_AWS_DIR.
set -euo pipefail
d="${FAKE_AWS_DIR:?}"; echo "$*" >> "$d/calls.log"
op="$2"; shift 2
id="" val=""
while [ $# -gt 0 ]; do
  case "$1" in
    --secret-id|--name) id="$2"; shift 2 ;;
    --secret-string) val="$2"; shift 2 ;;
    *) shift ;;
  esac
done
f="$d/$(echo "$id" | tr '/' '_')"
case "$op" in
  describe-secret|get-secret-value) [ -f "$f" ] || exit 254; [ "$op" = get-secret-value ] && cat "$f"; exit 0 ;;
  create-secret) [ ! -f "$f" ] || exit 254; cp "${val#file://}" "$f" ;;
  put-secret-value) [ -f "$f" ] || exit 254; cp "${val#file://}" "$f" ;;
esac
