{
  "name": "tryst-site",
  "version": "1.0.0",
  "private": true,
  "description": "TRYST public website and blog (static, no member data, indexable). Separate from the app (FR-075).",
  "scripts": {
    "sync-brand": "node scripts/sync-brand.mjs",
    "predev": "npm run sync-brand",
    "prebuild": "npm run sync-brand",
    "pretypecheck": "npm run sync-brand",
    "dev": "NEXT_TELEMETRY_DISABLED=1 next dev -p 3200",
    "build": "NEXT_TELEMETRY_DISABLED=1 next build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@fontsource/cormorant-garamond": "5.3.0",
    "@fontsource/jost": "5.3.0",
    "marked": "15.0.12",
    "next": "16.3.8",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "typescript": "5.9.3",
    "vitest": "^5.0.3"
  },
  "engines": {
    "node": "22.x"
  }
}
